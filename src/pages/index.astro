---
import Layout from "@/layouts/Layout.astro";
import { Picture } from "astro:assets";
import portrait from "@/assets/nejc.jpg";
import type { Person } from "schema-dts";

const NAME = "Neyts Zupan";
const TAGLINE = "Helping you grow your code and business.";
const BIO =
  "Geek since I was able to walk. Bootstrapped & powered by Open Source. Can help you with anything Python, Web, Security, CI/CD and SaaS.";

const skills = ["Python", "Web", "Security", "CI/CD", "SaaS"];

const socials = [
  {
    label: "X",
    handle: "@nzupan",
    href: "https://x.com/nzupan",
    // X / Twitter
    path: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
  },
  {
    label: "GitHub",
    handle: "zupo",
    href: "https://github.com/zupo",
    path: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  },
  {
    label: "LinkedIn",
    handle: "nzupan",
    href: "https://www.linkedin.com/in/nzupan/",
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Neyts Zupan",
  alternateName: "Nejc Zupan",
  description: BIO,
  url: Astro.site?.href ?? Astro.url.origin,
  jobTitle: "Software developer & founder",
  knowsAbout: ["Python", "Web", "Security", "CI/CD", "SaaS", "Open Source"],
  sameAs: socials.map((s) => s.href),
} satisfies Person;
---

<Layout
  description={TAGLINE}
  socialImageUrl="https://nejczupan.com/og.jpg"
  schema={personSchema}
>
  <main
    class="relative flex min-h-screen items-center justify-center overflow-hidden px-4 py-12 sm:py-16"
  >
    {/* Atmospheric backdrop: technical grid + drifting glow */}
    <div class="pointer-events-none absolute inset-0 bg-grid opacity-60"></div>
    <div
      class="pointer-events-none absolute -top-1/4 left-1/2 h-[42rem] w-[42rem] -translate-x-1/2 rounded-full bg-primary/10 blur-[120px] animate-drift"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(ellipse at center, transparent 55%, hsl(var(--background)) 100%);"
    >
    </div>

    {/* Terminal window */}
    <section
      class="animate-rise relative z-10 w-full max-w-2xl rounded-xl border border-border bg-card/80 shadow-2xl shadow-black/50 backdrop-blur-sm"
      aria-label={`${NAME} — personal card`}
    >
      {/* Title bar */}
      <div class="flex items-center gap-2 border-b border-border px-4 py-3">
        <span class="h-3 w-3 rounded-full bg-[#FF5F57]"></span>
        <span class="h-3 w-3 rounded-full bg-[#FEBC2E]"></span>
        <span class="h-3 w-3 rounded-full bg-[#28C840]"></span>
        <span class="ml-3 font-mono text-xs text-muted-foreground">neyts@zupan: ~</span>
      </div>

      {/* Body */}
      <div class="px-6 py-8 sm:px-10 sm:py-10">
        <p class="animate-rise font-mono text-sm text-muted-foreground [animation-delay:80ms]">
          <span class="text-primary">$</span> whoami
        </p>

        <div class="mt-6 flex flex-col items-start gap-6 sm:flex-row sm:items-center">
          <div
            class="animate-rise shrink-0 rounded-full p-[2px] ring-1 ring-border [animation-delay:160ms]"
            style="background: linear-gradient(140deg, hsl(var(--brand-green)), hsl(var(--brand-blue)));"
          >
            <Picture
              src={portrait}
              alt="Portrait of Neyts Zupan"
              formats={["webp"]}
              widths={[128, 256]}
              width={128}
              height={128}
              loading="eager"
              class="h-24 w-24 rounded-full border-2 border-card object-cover sm:h-28 sm:w-28"
            />
          </div>

          <div class="min-w-0">
            <h1
              class="animate-rise font-display text-4xl font-extrabold tracking-tight text-foreground [animation-delay:200ms] sm:text-5xl"
            >
              {NAME}
            </h1>
            <p class="animate-rise mt-1 font-mono text-sm text-muted-foreground [animation-delay:240ms]">
              <span class="text-accent">//</span> Nejc Zupan
            </p>
            <p class="animate-rise mt-3 font-medium text-primary [animation-delay:280ms]">
              {TAGLINE}
            </p>
          </div>
        </div>

        <p class="animate-rise mt-7 text-base leading-relaxed text-foreground/90 [animation-delay:340ms]">
          {BIO}
        </p>

        {/* Skill tags */}
        <ul class="animate-rise mt-6 flex flex-wrap gap-2 [animation-delay:400ms]">
          {skills.map((skill) => (
            <li class="rounded-md border border-border bg-secondary/60 px-2.5 py-1 font-mono text-xs text-foreground/80">
              {skill}
            </li>
          ))}
        </ul>

        {/* CTA + socials */}
        <div class="animate-rise mt-8 flex flex-col gap-5 [animation-delay:460ms] sm:flex-row sm:items-center sm:justify-between">
          <a
            href="https://www.linkedin.com/in/nzupan/"
            class="group inline-flex items-center justify-center gap-2 rounded-md bg-primary px-6 py-3 font-mono text-sm font-medium text-primary-foreground transition-transform duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-primary/25 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-card"
          >
            <span class="text-primary-foreground/70">&gt;</span> Let's talk!
          </a>

          <nav class="flex items-center gap-1" aria-label="Social profiles">
            {socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="me noreferrer"
                aria-label={`${s.label}: ${s.handle}`}
                title={`${s.label} — ${s.handle}`}
                class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-transparent text-muted-foreground transition-colors hover:border-border hover:bg-secondary/60 hover:text-foreground"
              >
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
                  <path d={s.path} />
                </svg>
              </a>
            ))}
          </nav>
        </div>

        {/* Closing prompt with blinking cursor */}
        <p class="animate-rise mt-8 font-mono text-sm text-muted-foreground [animation-delay:540ms]">
          <span class="text-primary">$</span>&nbsp;<span
            class="inline-block h-4 w-2 translate-y-0.5 bg-foreground/80 animate-blink"
            aria-hidden="true"></span>
        </p>
      </div>
    </section>
  </main>
</Layout>
